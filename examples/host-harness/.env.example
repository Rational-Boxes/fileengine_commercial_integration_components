# Embedding test harness config. Copy to .env. Never commit .env.
HARNESS_PORT=8181
# The ngrok HTTPS origin once tunneled (postMessage target + config echo).
# e.g. https://your-name.ngrok.io  — leave as localhost for a non-tunneled smoke test.
HARNESS_PUBLIC_ORIGIN=http://localhost:8181

# Session profile: oauth | delegated | passthrough
HARNESS_PROFILE=oauth
HARNESS_TENANT=filenginetest
HARNESS_OAUTH_PROVIDER=google

# À la carte component modules to demo (once the kit lands).
HARNESS_MODULES=file-browser,document-preview,comments
# Where to load the kit ESM from (local dist/ path or a CDN base). Empty until built.
HARNESS_KIT_BASE=

# FileEngine dev-stack service base URLs.
FILEENGINE_API_BASE=http://localhost:8090
FILEENGINE_CSAI_BASE=http://localhost:8092
FILEENGINE_DISCUSS_BASE=http://localhost:8094
FILEENGINE_BCF_BASE=http://localhost:8098

# --- delegated profile: TEST integration keypair (never a production key) ---
# The private key is auto-generated on first boot at HARNESS_INTEGRATION_KEY_FILE
# (default .integration_key.pem, gitignored); the matching .pub.pem is imported into
# FileEngine (INTEGRATION_PUBLIC_KEY_FILE). Override the issuer/audience if needed.
HARNESS_INTEGRATION_ISSUER=harness-integration
# HARNESS_INTEGRATION_AUDIENCE=   # defaults to FILEENGINE_API_BASE/v1/auth/exchange
# HARNESS_INTEGRATION_KEY_FILE=   # defaults to ./.integration_key.pem
